{
  "functions": [{
    "source": "functions",
    "codebase": "gallery",
    "runtime": "python313",
    "ignore": ["venv", "__pycache__", "*.pyc", ".env.local"]
  }],
  "hosting": {
    "public": "public",
    "cleanUrls": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/upload", "function": {"functionId": "upload_photo", "region": "us-central1"}},
      {"source": "/photos", "function": {"functionId": "list_photos", "region": "us-central1"}},
      {"source": "/photos/**", "function": {"functionId": "delete_photo", "region": "us-central1"}}
    ],
    "headers": [{
      "source": "**",
      "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]
    }]
  },
  "firestore": {"rules": "firestore.rules"},
  "emulators": {
    "functions": {"port": 5001},
    "hosting": {"port": 5000},
    "firestore": {"port": 8080},
    "ui": {"enabled": true},
    "singleProjectMode": true
  }
}
